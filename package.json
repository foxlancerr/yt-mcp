{
  "name": "youtube-studio-mcp",
  "version": "0.1.0",
  "description": "MCP server for YouTube channel owners — manage comments, analytics, videos, and playlists through Claude, Cursor, and any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "youtube-studio-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc && node scripts/banner.js",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "youtube-api",
    "youtube-studio",
    "creator-tools",
    "claude",
    "cursor",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "google-auth-library": "10.5.0",
    "googleapis": "^172.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.68.5",
    "@types/node": "^25.9.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
